{
  "version": 2,
  "builds": [
    { "src": "serveur.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].js" },
    { "src": "/admin/(.*)", "dest": "/public/dashboard.html" },
    { "src": "/messager", "dest": "/public/messager.html" },
    { "src": "/story", "dest": "/public/story.html" },
    { "src": "/parametres", "dest": "/public/parametres.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
